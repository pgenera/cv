#!/bin/sh
# Format cv.yaml, and rebuild dist/ with the commit's date, before a commit that
# changes the CV's sources. Enable with `make hooks`.
SRC="cv.yaml build.py boston_map.py og_image.py Makefile templates"
git diff --cached --quiet -- $SRC && exit 0
if ! git diff --quiet -- $SRC; then
	echo "pre-commit: CV sources have unstaged edits; stage or stash them first:" >&2
	git diff --name-only -- $SRC >&2
	exit 1
fi
if ! git diff --cached --quiet -- cv.yaml; then
	python3 fmt_yaml.py cv.yaml && git add cv.yaml || exit 1
fi
# -W cv.yaml: rebuild everything downstream of it, even if dist/ looks current.
log=$(SOURCE_DATE_EPOCH=$(date +%s) make -W cv.yaml 2>&1) || {
	echo "$log" | tail -20 >&2
	echo "pre-commit: build failed" >&2
	exit 1
}
echo "$log" | grep -E "PDF pages|Overfull" >&2
git add dist
