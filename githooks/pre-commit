#!/bin/sh
# Format cv.yaml and rebuild dist/ before a commit that changes the CV's
# sources. The PDF gets the commit's date only when cv.yaml changes; otherwise
# make keeps the date already in dist/. Enable with `make hooks`.
SRC="cv.yaml build.py boston_map.py og_image.py Makefile templates"
git diff --cached --quiet -- $SRC && exit 0
if ! git diff --quiet -- $SRC; then
	files=$(git diff --name-only -- $SRC)
	echo "pre-commit: CV sources have unstaged edits:" $files >&2
	echo "Include them with: git add" $files >&2
	exit 1
fi
if ! git diff --cached --quiet -- cv.yaml; then
	python3 fmt_yaml.py cv.yaml && git add cv.yaml || exit 1
	SOURCE_DATE_EPOCH=$(date +%s) && export SOURCE_DATE_EPOCH
fi
# -W cv.yaml: rebuild everything downstream of it, even if dist/ looks current.
log=$(make -W cv.yaml 2>&1) || {
	echo "$log" | tail -20 >&2
	echo "pre-commit: build failed" >&2
	exit 1
}
echo "$log" | grep -E "PDF pages|Overfull" >&2
git add dist
